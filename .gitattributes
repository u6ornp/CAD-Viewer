# Auto detect text files and normalize line endings to LF
* text=auto

# Python files
*.py text eol=lf
*.bat text eol=crlf
*.sh text eol=lf

# HTML/CSS/JS
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.stl binary
*.obj binary
